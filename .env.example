# Local data paths and vegetation thresholds
FORESTWATCH_DATASET=dataset
FORESTWATCH_OUTPUT=data
FORESTWATCH_PROJECT_DATA=C:\path\to\satellite-data
FORESTWATCH_LOW_NDVI=0.3
FORESTWATCH_HEALTHY_NDVI=0.6
FORESTWATCH_DECREASE=-0.15

# Optional SMTP configuration for alerts sent to the signed-in account email.
# Gmail example: use smtp.gmail.com, port 587, and a Google App Password.
FORESTWATCH_SMTP_HOST=smtp.example.com
FORESTWATCH_SMTP_PORT=587
FORESTWATCH_SMTP_USERNAME=your-email@example.com
FORESTWATCH_SMTP_PASSWORD=your-app-password
FORESTWATCH_SMTP_FROM=your-email@example.com
